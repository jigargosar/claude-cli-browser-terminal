{
  "name": "claude-cli-browser-terminal",
  "version": "0.1.6",
  "description": "",
  "bin": {
    "ccw": "server.mjs"
  },
  "files": [
    "server.mjs",
    "dist"
  ],
  "scripts": {
    "watch": "node scripts/build-watch/start-build-watch-holding-port.mjs",
    "watch:about": "echo Rebuilds dist/ on every change in web/. Run it first, in its own terminal. Why: scripts/build-watch/README.md",
    "ccw": "node scripts/build-watch/refuse-start-without-build-watch.mjs && node server.mjs",
    "ccw:about": "echo Starts a session. Refuses to start without pnpm watch, so the page is never stale. Why: scripts/build-watch/README.md",
    "release": "vite build && pnpm version patch && pnpm pack --pack-destination published-versions && pnpm pack --out published-versions/claude-cli-browser-terminal.tgz && git push --follow-tags",
    "test": "vite build && cross-env CC_WEB_PORT=7682 node server.mjs --model haiku"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "chokidar": "5.0.0",
    "get-port": "7.2.0",
    "open": "11.0.4",
    "sirv": "3.0.2",
    "tail": "2.2.6",
    "write-file-atomic": "8.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@floating-ui/core": "1.8.0",
    "@floating-ui/dom": "1.8.0",
    "@highlightjs/cdn-assets": "11.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "clipboardy": "5.3.2",
    "cross-env": "10.1.0",
    "dompurify": "3.4.17",
    "impeccable": "4.5.2",
    "is-port-reachable": "4.0.0",
    "marked": "18.1.1",
    "marked-highlight": "2.2.4",
    "puppeteer-core": "25.14.0",
    "tabbable": "6.5.0",
    "vite": "8.3.4"
  }
}
