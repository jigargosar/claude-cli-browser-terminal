{
  "name": "claude-cli-browser-terminal",
  "version": "0.1.1",
  "description": "",
  "bin": {
    "ccw": "server.mjs"
  },
  "files": [
    "server.mjs",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "ccw": "vite build && node server.mjs",
    "release": "vite build && pnpm version patch && pnpm pack --pack-destination published-versions && git push --follow-tags",
    "new": "vite build && node server.mjs --model haiku",
    "resume": "vite build && node server.mjs --resume",
    "test": "vite build && cross-env CC_WEB_PORT=7682 node server.mjs --model haiku"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "chokidar": "5.0.0",
    "get-port": "7.2.0",
    "open": "11.0.4",
    "sirv": "3.0.2",
    "tail": "2.2.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "cross-env": "10.1.0",
    "dompurify": "3.4.16",
    "impeccable": "4.5.2",
    "marked": "18.1.0",
    "marked-highlight": "2.2.4",
    "puppeteer-core": "25.13.0",
    "vite": "8.3.4"
  }
}
