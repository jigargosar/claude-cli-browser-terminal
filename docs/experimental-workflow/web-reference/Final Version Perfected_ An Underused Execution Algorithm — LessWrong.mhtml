class=3D"mjx-math"><span aria-hidden=3D"true" class=3D"mjx-mrow"><span clas=
s=3D"mjx-mi"><span style=3D"padding-top:0.519em;padding-bottom:0.298em" cla=
ss=3D"mjx-char MJXc-TeX-math-I">O</span></span><span class=3D"mjx-mo"><span=
